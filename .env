# FilmRoom Environment Variables
# For free-tier Cloudinary integration with Expo Go:
# 1. Create a free account at https://cloudinary.com
# 2. Get your Cloud Name from the dashboard
# 3. Create an Unsigned Upload Preset under:
#    Settings -> Upload -> Upload presets -> Add upload preset -> Signing Mode: Unsigned

EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=filmroom_media
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=filmroom_unsigned
