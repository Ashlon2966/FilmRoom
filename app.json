{
  "expo": {
    "name": "FilmRoom",
    "slug": "filmroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0d0e"
    },
    "ios": {
      "bundleIdentifier": "com.ashy123.filmroom",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ashy123.filmroom",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0d0e"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "cloudinaryCloudName": "",
      "cloudinaryUploadPreset": "",
      "eas": {
        "projectId": "b4a581c9-7260-4dde-aa2f-19f6adee231e"
      }
    },
    "owner": "ashy123"
  }
}
