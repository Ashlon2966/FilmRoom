rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles & Discovery
    match /users/{userId} {
      // Authenticated users can browse filmmakers in the talent directory
      allow read: if isAuthenticated();
      // Only account owner can edit their own profile
      allow create, update, delete: if isOwner(userId);

      // Private personal info (never public)
      match /private/{documentId} {
        allow read, write: if isOwner(userId);
      }

      // Private Shortlists (only visible to list owner)
      match /shortlists/{shortlistId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Contact Requests (Flow A & Flow B + Representation Routing)
    match /contact_requests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sender.uid ||
        request.auth.uid == resource.data.recipientUid ||
        request.auth.uid == resource.data.targetTalent.uid
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.sender.uid;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientUid ||
        request.auth.uid == resource.data.sender.uid ||
        request.auth.uid == resource.data.targetTalent.uid
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.sender.uid;
    }

    // 3. User-to-User Connections (Decoupled from chats and rooms)
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        (resource.data.users != null && request.auth.uid in resource.data.users) ||
        (resource.data.uids != null && request.auth.uid in resource.data.uids)
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.users != null && request.auth.uid in request.resource.data.users) ||
        (request.resource.data.uids != null && request.auth.uid in request.resource.data.uids)
      );
      allow update: if isAuthenticated() && (
        (resource.data.users != null && request.auth.uid in resource.data.users) ||
        (resource.data.uids != null && request.auth.uid in resource.data.uids)
      );
      allow delete: if isAuthenticated() && (
        (resource.data.users != null && request.auth.uid in resource.data.users) ||
        (resource.data.uids != null && request.auth.uid in resource.data.uids)
      );
    }

    // 4. Direct Message Threads
    match /direct_threads/{threadId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participantIds);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
    }

    // 5. Direct Messages
    match /direct_messages/{threadId}/chats/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isAuthenticated();
    }

    // 6. Production Rooms & Slate
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;

      // Subcollections (Takes, Stages, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 7. Public Crew Calls on The Board
    match /production_calls/{callId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
  }
}
